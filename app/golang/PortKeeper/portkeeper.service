[Unit]
Description=PortKeeper TCP access manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/app/golang/PortKeeper
ExecStart=/app/golang/PortKeeper/portkeeper -config /app/golang/PortKeeper/config.yaml
Restart=on-failure
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
