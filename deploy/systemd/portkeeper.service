[Unit]
Description=PortKeeper TCP access manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portkeeper
Group=portkeeper
WorkingDirectory=/app/golang/PortKeeper
ExecStart=/app/golang/PortKeeper/portkeeper -config /app/golang/PortKeeper/config.yaml
Restart=on-failure
RestartSec=3
ReadWritePaths=/var/lib/portkeeper /app/golang/PortKeeper/config.yaml
StateDirectory=portkeeper
StateDirectoryMode=0750
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true

[Install]
WantedBy=multi-user.target
